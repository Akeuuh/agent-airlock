# Provider Anthropic Claude Pro/Max — ABONNEMENT (OAuth), pas une clé d'API.
# À distinguer du provider `anthropic` (clé ANTHROPIC_API_KEY, facturé au token).
# Login via /login → Claude Pro/Max dans le harness ; token dans auth.json (volume).
PROVIDER_KEYS=""
# Domaines joints DEPUIS le conteneur : échange de token (platform.claude.com) +
# inférence (api.anthropic.com). L'autorisation (claude.ai) se fait dans le
# navigateur de l'HÔTE, hors allowlist.
PROVIDER_DOMAINS="platform.claude.com .anthropic.com"
PROVIDER_AUTH="oauth"
# Callback OAuth en loopback sur un port FIXE (cf. pi). Le launcher le publie
# VM→hôte pour que le navigateur complète le redirect http://localhost:53692.
PROVIDER_CALLBACK_PORT="53692"
# pi bind son serveur de callback sur cet host ; 0.0.0.0 pour qu'il soit joignable
# via le port publié (sinon il n'écoute que le loopback du conteneur).
PROVIDER_RUN_ENV="PI_OAUTH_CALLBACK_HOST=0.0.0.0"
