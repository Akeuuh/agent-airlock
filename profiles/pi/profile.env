# Profil harness : pi (@earendil-works/pi-coding-agent).
# Sourcé par le launcher/doctor via lib/profiles.sh. Décrit TOUT ce qui est
# spécifique au harness ; le reste du socle est générique.
#
# pi exerce le chemin NON-Claude : auth par clé d'API (pas d'OAuth navigateur),
# donc pas de resync horloge VM. C'est le profil de validation du mode apikey.

HARNESS_NAME="pi"
HARNESS_BIN="pi"
# pi tourne avec toutes les permissions par défaut (pas de flag « skip » à passer).
HARNESS_LAUNCH_ARGS=""

# Config DANS le conteneur (monté sur volume persistant) : auth.json, settings,
# sessions, extensions, skills… pi utilise un chemin fixe, pas de variable d'env.
HARNESS_CONFIG_DIR="/home/agent/.pi/agent"
HARNESS_CONFIG_ENV=""
HARNESS_HOME_VOL="agent-home-pi"
# Chemin du config-dir pi sur l'HÔTE — utilisé par agent-import-auth.sh pour
# récupérer un login OAuth fait côté hôte (ex. Claude Pro/Max) ET par
# agent-import-config.sh pour seeder la config hôte dans le sandbox.
HARNESS_HOST_CONFIG_DIR="$HOME/.pi/agent"
# Allowlist des items de config à importer depuis l'hôte (agent-import-config.sh).
# Config "pure" uniquement — les symlinks (ex. ../shared) sont déréférencés à la
# copie. Secrets (auth.json, mcp-auth) et état lourd (sessions, .skill-state)
# sont EXCLUS par principe. mcp.json est REDIRIGÉ vers agent-mcp-wire.sh
# (les serveurs MCP passent par le sidecar proxy, pas en direct).
# npm/ = node_modules partagé où pi résout les DEPS des extensions (ex. zod) ;
# inclus car les extensions ne chargent pas sans (23M, JS pur, cross-plateforme).
HARNESS_HOST_CONFIG_ITEMS="settings.json models.json agents AGENTS.md extensions skills trust.json pi-memory npm"

# apikey : la clé est injectée au run depuis secrets.env (prioritaire) ou l'env
# hôte. Aucun token horodaté → pas de resync horloge (voir launcher §1b).
# Exception : un provider OAuth actif (ex. github-copilot) réactive resync + check login.
HARNESS_AUTH_MODE="apikey"
# Credentials pi (auth.json) — utilisé par le doctor quand un provider OAuth est actif.
HARNESS_CREDENTIALS_FILE="auth.json"
# Providers actifs par défaut (catalogue providers/) — chacun apporte SA clé ET son
# domaine egress. Override au run : --provider <name> ou $AGENT_PROVIDERS.
# ex: "anthropic openai deepseek". Pense à sélectionner le provider correspondant
# DANS pi (--provider / modèle par défaut).
HARNESS_PROVIDERS="anthropic"
# (optionnel) clés hors catalogue — ouvre alors leur domaine dans allowlist.conf.
HARNESS_ENV_KEYS=""

# Variables d'env additionnelles injectées au run (KEY=VAL séparés par espaces).
# PI_OFFLINE=1 : egress verrouillé → coupe le check de version (pi.dev) et les
# downloads d'outils (rg/fd sont trouvés sur le PATH AVANT le test offline, donc
# ils marchent ; toute autre tentative de download échoue proprement au lieu de
# hang/erreur). N'affecte PAS les appels au provider (modèle).
HARNESS_RUN_ENV="PI_OFFLINE=1"
