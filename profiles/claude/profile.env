# Profil harness : Claude Code (Anthropic).
# Sourcé par le launcher/doctor via lib/profiles.sh. Décrit TOUT ce qui est
# spécifique au harness ; le reste du socle est générique.

HARNESS_NAME="claude"
HARNESS_BIN="claude"
HARNESS_LAUNCH_ARGS="--dangerously-skip-permissions"

# Répertoire de config DANS le conteneur (monté sur volume persistant).
HARNESS_CONFIG_DIR="/home/agent/.claude"
# Nom de la variable d'env que le harness lit pour localiser sa config.
HARNESS_CONFIG_ENV="CLAUDE_CONFIG_DIR"
# Volume persistant du login (credentials abonnement). Un par harness.
HARNESS_HOME_VOL="agent-home-claude"

# oauth : login navigateur + credentials persistés. (apikey → phase 5)
HARNESS_AUTH_MODE="oauth"
HARNESS_CREDENTIALS_FILE=".credentials.json"

# Chemin du config-dir Claude Code sur l'HÔTE + allowlist d'items à importer
# via agent-import-config.sh (config pure ; secrets/état exclus par principe).
# .credentials.json, sessions, projects, history.jsonl, caches sont EXCLUS.
HARNESS_HOST_CONFIG_DIR="$HOME/.claude"
HARNESS_HOST_CONFIG_ITEMS="settings.json CLAUDE.md agents commands"

# Variables d'env additionnelles injectées au run (KEY=VAL séparés par espaces).
HARNESS_RUN_ENV="DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1"
