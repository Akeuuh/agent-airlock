# Profil harness : opencode (opencode-ai, agent de terminal open-source).
# Sourcé par le launcher/doctor via lib/profiles.sh. Décrit TOUT ce qui est
# spécifique au harness ; le reste du socle est générique.
#
# Auth par clé d'API (comme pi) → pas de resync horloge VM.

HARNESS_NAME="opencode"
HARNESS_BIN="opencode"
HARNESS_LAUNCH_ARGS=""

# Config DANS le conteneur (volume persistant) : config.json seedé depuis l'image.
# NB : opencode écrit ses sessions/état dans ~/.local/share/opencode (NON persisté
# par ce volume → éphémère au run). L'auth passe par l'env (apikey), pas auth.json.
HARNESS_CONFIG_DIR="/home/agent/.config/opencode"
HARNESS_CONFIG_ENV=""
HARNESS_HOME_VOL="agent-home-opencode"

# Chemin du config-dir opencode sur l'HÔTE + allowlist d'items à importer via
# agent-import-config.sh (config pure ; node_modules/lockfiles/état exclus).
HARNESS_HOST_CONFIG_DIR="$HOME/.config/opencode"
HARNESS_HOST_CONFIG_ITEMS="opencode.json AGENTS.md commands skills"

# apikey : clé injectée depuis secrets.env (prioritaire) ou l'env hôte.
HARNESS_AUTH_MODE="apikey"
# Providers actifs par défaut (catalogue providers/) — chacun apporte SA clé ET son
# domaine egress. Override au run : --provider <name> ou $AGENT_PROVIDERS.
# Pense à sélectionner le provider correspondant DANS opencode (/models).
HARNESS_PROVIDERS="anthropic"
# (optionnel) clés hors catalogue — ouvre alors leur domaine dans allowlist.conf.
HARNESS_ENV_KEYS=""

HARNESS_RUN_ENV=""
