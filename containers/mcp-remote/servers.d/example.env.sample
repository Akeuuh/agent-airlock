# Modèle de serveur MCP OAuth.
# Copier ce fichier en « <nom>.env » (les *.env réels sont git-ignorés).
#
# NAME          identifiant lisible (logs)
# URL           endpoint du serveur MCP HTTP/SSE distant
# PORT          port TCP écouté sur le réseau interne (doit matcher config/mcp.json côté A)
# CALLBACK_PORT port de callback OAuth (doit matcher OAUTH_CALLBACK_PORT du launcher)
# ALLOWED_TOOLS filtre optionnel : liste des tools autorisés (retirer les destructeurs)

NAME=exemple
URL=https://mcp.exemple.com/sse
PORT=9000
CALLBACK_PORT=9910
# ALLOWED_TOOLS=search,read
