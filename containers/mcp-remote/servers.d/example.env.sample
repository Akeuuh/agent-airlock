# Modèle de serveur MCP. Copier ce fichier en « <nom>.env » (les *.env réels sont git-ignorés).
#
# Le proxy.js fait l'OAuth automatiquement (PKCE + callback) si aucun token n'est présent.
#
# NAME          identifiant lisible (logs)
# URL           endpoint du serveur MCP streamable-http distant
# PORT          port TCP écouté sur le réseau interne (doit matcher config/mcp.json côté harness)
# CALLBACK_PORT port de callback OAuth — UNIQUE par serveur (ex. 9910, 9911…)

NAME=exemple
URL=https://mcp.exemple.com/mcp
PORT=9000
CALLBACK_PORT=9910
