# ── Image A : Claude Code sandboxé ────────────────────────────────────────────
# Base node (Claude Code tourne sur node). mise fournit les outils PAR REPO.
FROM node:22-bookworm-slim

# Outils système : socat (tunnel MCP), git, curl (installe mise)
RUN apt-get update && apt-get install -y --no-install-recommends \
      socat git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Claude Code (package officiel Anthropic)
RUN npm install -g @anthropic-ai/claude-code

# Entrypoint (copié en root avant de dropper les privilèges)
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && useradd -ms /bin/bash claude

USER claude

# mise (gestionnaire d'outils déclaratif par repo)
RUN curl -fsSL https://mise.run | sh
ENV PATH="/home/claude/.local/bin:/home/claude/.local/share/mise/shims:${PATH}"

# Config commune embarquée : MCP, skills, plugins, hooks neutres
COPY --chown=claude:claude config/            /home/claude/.claude/
COPY --chown=claude:claude git-hooks-template/ /home/claude/.git-hooks-template/

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
