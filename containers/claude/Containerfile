# ── Image A : Claude Code sandboxé ────────────────────────────────────────────
# Base node (Claude Code tourne sur node). mise fournit les outils PAR REPO.
FROM node:22-bookworm-slim

# Outils système : socat (tunnel MCP), git, curl (installe mise)
RUN apt-get update && apt-get install -y --no-install-recommends \
      socat git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Claude Code (package officiel Anthropic)
RUN npm install -g @anthropic-ai/claude-code

# Entrypoint (copié en root avant de dropper les privilèges)
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && useradd -ms /bin/bash claude

USER claude

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# mise (gestionnaire d'outils déclaratif par repo)
RUN curl -fsSL https://mise.run | sh
ENV PATH="/home/claude/.local/bin:/home/claude/.local/share/mise/shims:${PATH}"

# Config commune : distribuée dans /opt (rafraîchie à chaque run par l'entrypoint),
# le vrai ~/.claude est un VOLUME persistant (credentials du login abonnement).
COPY --chown=claude:claude config/            /opt/claude-dist/config/
COPY --chown=claude:claude git-hooks-template/ /home/claude/.git-hooks-template/
RUN mkdir -p /home/claude/.claude
ENV CLAUDE_CONFIG_DIR=/home/claude/.claude

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
